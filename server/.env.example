# UPAK Fork Environment Variables

# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token

# YooKassa Payment Configuration
YANDEX_CHECKOUT_SHOP_ID=your_shop_id
YANDEX_CHECKOUT_KEY=your_secret_key

# Database Configuration
DATABASE_URL=sqlite:///upak.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=change_me

# YandexGPT
YANDEX_GPT_API_KEY=your_yandex_cloud_api_key
YANDEX_GPT_FOLDER_ID=your_folder_id

# External Services (Optional)
BITRIX24_WEBHOOK=
YANDEX_METRIKA_ID=
REDIS_URL=
